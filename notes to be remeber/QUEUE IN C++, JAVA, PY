JAVA 
NO BUILT IN SWAP 

import java.util.Queue;
import java.util.LinkedList;

public class Main {
    public static void main(String[] args) {
        Queue<Integer> q1 = new LinkedList<>();
        Queue<Integer> q2 = new LinkedList<>();
        
        q1.add(10);
        q1.add(20);
        q1.add(30);
        
        q2.add(99);
        q2.add(88);
        
        System.out.println("Before swap:");
        System.out.println("q1 front: " + q1.peek());  // 10
        System.out.println("q2 front: " + q2.peek());  // 99
        
        // ✅ MANUAL SWAP USING TEMP
        Queue<Integer> temp = new LinkedList<>();
        temp.addAll(q1);
        q1.clear();
        q1.addAll(q2);
        q2.clear();
        q2.addAll(temp);
        
        System.out.println("After swap:");
        System.out.println("q1 front: " + q1.peek());  // 99
        System.out.println("q2 front: " + q2.peek());  // 10
    }
}

Java - Swap Using Constructor
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Queue<Integer> q1 = new LinkedList<>(Arrays.asList(10, 20, 30));
        Queue<Integer> q2 = new LinkedList<>(Arrays.asList(99, 88, 77));
        
        System.out.println("Before: q1=" + q1 + ", q2=" + q2);
        
        // Swap using constructor
        Queue<Integer> temp = new LinkedList<>(q1);
        q1.clear();
        q1.addAll(q2);
        q2.clear();
        q2.addAll(temp);
        
        System.out.println("After: q1=" + q1 + ", q2=" + q2);
    }
}
PYTHON - SWAP
NO BUILT IN SWAP 

from collections import deque

q1 = deque([10, 20, 30])
q2 = deque([99, 88, 77])

print("Before swap:")
print("q1:", list(q1))  # [10, 20, 30]
print("q2:", list(q2))  # [99, 88, 77]

# ✅ MANUAL SWAP USING TEMP
temp = q1.copy()
q1.clear()
q1.extend(q2)
q2.clear()
q2.extend(temp)

print("After swap:")
print("q1:", list(q1))  # [99, 88, 77]
print("q2:", list(q2))  # [10, 20, 30]

