JAVA IN BACK 

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Queue<Integer> q = new LinkedList<>();
        q.add(10);
        q.add(20);
        q.add(30);
        
        // ❌ NO back() method in Java Queue
        // q.back();  // ERROR!
        
        // ✅ METHOD 1: Convert to array
        Integer[] arr = q.toArray(new Integer[0]);
        System.out.println("Back element: " + arr[arr.length - 1]);  // 30
        
        // ✅ METHOD 2: Use ArrayList
        ArrayList<Integer> list = new ArrayList<>(q);
        System.out.println("Back element: " + list.get(list.size() - 1));  // 30
        
        // ✅ METHOD 3: Use Deque instead
        Deque<Integer> dq = new ArrayDeque<>();
        dq.addLast(10);
        dq.addLast(20);
        dq.addLast(30);
        System.out.println("Back element: " + dq.getLast());  // 30
    }
}

C++ SEARCH IN QUEUE 
#include <bits/stdc++.h>
using namespace std;

// ✅ Custom search function
bool searchQueue(queue<int> q, int target) {
    while (!q.empty()) {
        if (q.front() == target) {
            return true;
        }
        q.pop();
    }
    return false;
}

// ✅ Get position from front
int searchQueuePosition(queue<int> q, int target) {
    int pos = 1;
    while (!q.empty()) {
        if (q.front() == target) {
            return pos;
        }
        q.pop();
        pos++;
    }
    return -1;
}

int main() {
    queue<int> q;
    q.push(10);
    q.push(20);
    q.push(30);
    q.push(40);
    q.push(50);
    
    // Search
    cout << "Contains 30: " << searchQueue(q, 30) << endl;       // 1 (true)
    cout << "Contains 99: " << searchQueue(q, 99) << endl;       // 0 (false)
    
    // Position from front
    cout << "Position of 30: " << searchQueuePosition(q, 30) << endl;  // 3
    cout << "Position of 50: " << searchQueuePosition(q, 50) << endl;  // 5
    cout << "Position of 99: " << searchQueuePosition(q, 99) << endl;  // -1
    
    return 0;
}

