JAVA

import java.util.Stack;

public class Main {
    public static void main(String[] args) {
        Stack<Integer> stk1 = new Stack<>();
        Stack<Integer> stk2 = new Stack<>();
        
        stk1.push(10);
        stk1.push(20);
        stk1.push(30);
        
        stk2.push(99);
        stk2.push(88);
        
        System.out.println("Before swap:");
        System.out.println("stk1 top: " + stk1.peek());  // 30
        System.out.println("stk2 top: " + stk2.peek());  // 88
        
        // ❌ NO BUILT-IN SWAP - Use temp
        Stack<Integer> temp = new Stack<>();
        temp.addAll(stk1);
        stk1.clear();
        stk1.addAll(stk2);
        stk2.clear();
        stk2.addAll(temp);
        
        System.out.println("After swap:");
        System.out.println("stk1 top: " + stk1.peek());  // 88
        System.out.println("stk2 top: " + stk2.peek());  // 30
    }
}


PYTHON 

from collections import deque

stk1 = deque([10, 20, 30])
stk2 = deque([99, 88])

print("Before swap:")
print("stk1 top:", stk1[-1])  # 30
print("stk2 top:", stk2[-1])  # 88

# ❌ NO BUILT-IN SWAP - Use temp
temp = stk1.copy()
stk1.clear()
stk1.extend(stk2)
stk2.clear()
stk2.extend(temp)

print("After swap:")
print("stk1 top:", stk1[-1])  # 88
print("stk2 top:", stk2[-1])  # 30


