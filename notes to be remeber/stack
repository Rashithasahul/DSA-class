C++

#include <bits/stdc++.h>
using namespace std;

// Custom search function
int searchStack(stack<int> s, int target) {
    int pos = 1;
    while (!s.empty()) {
        if (s.top() == target) {
            return pos;
        }
        s.pop();
        pos++;
    }
    return -1; // Not found
}

int main() {
    stack<int> stk;
    stk.push(10);
    stk.push(20);
    stk.push(30);
    stk.push(40);
    stk.push(50);
    
    cout << "Position of 30: " << searchStack(stk, 30) << endl;  // 3
    cout << "Position of 50: " << searchStack(stk, 50) << endl;  // 1
    cout << "Position of 99: " << searchStack(stk, 99) << endl;  // -1
    
    return 0;
}


