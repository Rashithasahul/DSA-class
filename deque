# 🔥 Complete Example

Suppose we start with:

```text
[1, 2, 3]
```

### C++

```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {

    deque<int> dq = {1, 2, 3};

    dq.push_front(0);
    dq.push_back(4);

    cout << "Front: " << dq.front() << endl;
    cout << "Back: " << dq.back() << endl;

    dq.pop_front();
    dq.pop_back();

    for(auto x : dq) {
        cout << x << " ";
    }

    return 0;
}
```

Output:

```text
Front: 0
Back: 4
1 2 3
```

---

### Java

```java
import java.util.*;

class Main {
    public static void main(String[] args) {

        Deque<Integer> dq = new ArrayDeque<>();

        dq.addLast(1);
        dq.addLast(2);
        dq.addLast(3);

        dq.addFirst(0);
        dq.addLast(4);

        System.out.println("Front: " + dq.getFirst());
        System.out.println("Back: " + dq.getLast());

        dq.removeFirst();
        dq.removeLast();

        for(int x : dq) {
            System.out.print(x + " ");
        }
    }
}
```

---

### Python

```python
from collections import deque

dq = deque([1, 2, 3])

dq.appendleft(0)
dq.append(4)

print("Front:", dq[0])
print("Back:", dq[-1])

dq.popleft()
dq.pop()

for x in dq:
    print(x, end=" ")
```

